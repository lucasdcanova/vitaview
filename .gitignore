# Dependencies
node_modules
desktop/node_modules

# Build output
dist
desktop/dist
desktop/release
server/public
.next
out
build

# Env / secrets — never commit
.env
.env.local
.env.development
.env.production
.env.*.local
secrets/
*.pem
*.p8
*.p12
*.keystore
*.jks
keystore.properties
GoogleService-Info.plist
google-services.json

# Healthcare / PHI — never commit real patient data or exam outputs
# These are placeholders to ensure ad-hoc clinical artifacts never reach git.
*.dcm
laudos/
exames/
attached_assets/laudo*.pdf
attached_assets/Resultado*.pdf
attached_assets/*.jpeg
attached_assets/*.jpg
# Root-level lab-report PDFs (typical Brazilian lab filename patterns: YYYYMMDD_*, Resultado*).
/[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]_*.pdf
/Resultado*.pdf
/laudo*.pdf

# Cookies and auth dumps
cookies.txt
test-cookies.txt
*.cookies

# OS / editor noise
.DS_Store
*.swp
*~
.idea/
.vscode/*.local

# Agent / Claude Code local settings — per-machine workflow, not portable.
.claude/settings.local.json
.claude/projects/
.agent/
.agents/

# One-off browser scratch pages that historically held literal pk_* keys.
client/test-stripe.html
client/test-*.html

# macOS Finder duplicates ("foo 2.ts", "foo 3.ts")
* 2.*
* 3.*

