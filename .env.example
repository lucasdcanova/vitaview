# VitaView AI — example environment file
# Copy to .env and fill in real values. Never commit .env.
# See README.md and docs/SYSTEM_INVENTORY.md for the rationale of each variable.

# --- Core ------------------------------------------------------------------
DATABASE_URL=postgres://user:password@host:5432/vitaview
SESSION_SECRET=
PORT=3000
NODE_ENV=development

# --- OpenAI ----------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_GPT5_MODEL=
OPENAI_ANALYSIS_MODEL=
OPENAI_FALLBACK_MODEL=
OPENAI_ANALYSIS_MAX_OUTPUT_TOKENS=

# --- Stripe ----------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLIC_KEY=
APP_URL=http://localhost:3000

# --- Email (SMTP) ----------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=

# --- Storage (S3, optional) ------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
AWS_S3_BUCKET_NAME=

# --- HTTPS / security / backup (advanced, optional) ------------------------
HTTP_PORT=
HTTPS_PORT=
SSL_CERT_PATH=
SSL_KEY_PATH=
SSL_CHAIN_PATH=
SSL_DH_PATH=
DOMAIN=
LOG_LEVEL=info
BACKUP_DIR=
OFFSITE_BACKUP_DIR=
BACKUP_MASTER_KEY=
MASTER_KEY=
MASTER_ENCRYPTION_KEY=
ENCRYPTION_SALT=
SALT_SEED=
